{
  "global": { "files": "/src/**/*.*" },
  "dependencies": [{ "url": "https://github.com/abaplint/deps", "folder": "/deps", "files": "/src/**/*.*" }],
  "syntax": { "version": "v750", "errorNamespace": "^(Z|LCL|LTCL|TY_|TT_)" },
  "rules": {
    "parser_error": { "exclude": ["^(?!.*zcl_bn_(dataset|context|service|types|bpc)\\.).*$"] },
    "check_syntax": { "exclude": ["^(?!.*zcl_bn_(dataset|context|service|types|bpc)\\.).*$"] }
  }
}
