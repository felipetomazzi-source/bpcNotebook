script version 2
dataset input_data = "step_01" named "INPUT_DATA"
dataset new_data = "step_05" named "NEW_DATA"
filter filtered1 = input_data as f2 where f2.DEMREVID_KFS == "DEMREVID019" and is_in(f2.DOC_TYP, ["RS","AD","AC"]) and f2.UFB_DR_ID != "UFBDRID006" and f2.UFB_DR_ID != "UFB_DR_ID_NA"
group group3 = filtered1 exclude ["DOC_TYP","UFB_DR_ID","LFC_WIN_SUPPLIER"]
for g4 in group3
if initial(g4.ACCOUNT)
g4.ACCOUNT = "ACCOUNT_NA"
end
if initial(g4.AUDITTRAIL)
g4.AUDITTRAIL = "AUDITTRAIL_NA"
end
if initial(g4.CATEGORY)
g4.CATEGORY = "CATEGORY_NA"
end
if initial(g4.COSTCENTRE)
g4.COSTCENTRE = "COSTCENTRE_NA"
end
if initial(g4.DEMREVID_KFS)
g4.DEMREVID_KFS = "DEMREVID_KFS_NA"
end
if initial(g4.FFLAS)
g4.FFLAS = "FFLAS_NA"
end
if initial(g4.FFLAS_SUBSET)
g4.FFLAS_SUBSET = "FFLAS_SUBSET_NA"
end
if initial(g4.MATCONN)
g4.MATCONN = "MATCONN_NA"
end
if initial(g4.TIME)
g4.TIME = "TIME_NA"
end
if initial(g4.PRODUCT_TYPE)
g4.PRODUCT_TYPE = "PRODUCT_TYPE_NA"
end
if initial(g4.GEO_DRIVERS)
g4.GEO_DRIVERS = "GDRVS_NA"
end
if initial(g4.DOC_TYP)
g4.DOC_TYP = "DOC_TYP_NA"
end
if initial(g4.CONN_REG_SPLIT)
g4.CONN_REG_SPLIT = "CONN_REG_SPLIT_NA"
end
if initial(g4.LFC_WIN_SUPPLIER)
g4.LFC_WIN_SUPPLIER = "LFC_WIN_SUPPLIER_NA"
end
if initial(g4.MAT_GROUP_ID)
g4.MAT_GROUP_ID = "MAT_GROUP_ID_NA"
end
if initial(g4.REG_FFLAS_SERV)
g4.REG_FFLAS_SERV = "REG_FFLAS_SERV_NA"
end
if initial(g4.UFB_DR_ID)
g4.UFB_DR_ID = "UFB_DR_ID_NA"
end
if initial(g4.MATREMAP)
g4.MATREMAP = "MATREMAP_NA"
end
if initial(g4.RSP_SERVICE_ID)
g4.RSP_SERVICE_ID = "RSP_SERVICE_ID_NA"
end
if initial(g4.REV_ID_GROUP)
g4.REV_ID_GROUP = "REV_ID_GROUP_NA"
end
end
sort group3 unstable by DOC_TYP asc, UFB_DR_ID asc, LFC_WIN_SUPPLIER asc
for replace5 in group3
replace5.DEMREVID_KFS = "DEMREVID016"
replace5.AUDITTRAIL = "DEMREVID_CALC"
end
dataset conn_reg_split = "step_01" named "CONN_REG_SPLIT"
dataset l1_l2_mapping = "step_01" named "L1_L2_MAPPING"
dataset mat_group_mapping = "step_01" named "MAT_GROUP_MAPPING"
dataset product_members = "step_01" named "PRODUCT_MEMBERS"
dataset material_members = "step_01" named "MATERIAL_MEMBERS"
dataset group_members = "step_01" named "GROUP_MEMBERS"
filter filtered6 = input_data as f7 where f7.DEMREVID_KFS == "DEMREVID036"
filter filtered8 = input_data as f9 where f9.DEMREVID_KFS == "DEMREVID037"
filter filtered10 = input_data as f11 where f11.DEMREVID_KFS == "DEMREVID014"
sort filtered6 unstable by TIME asc, ACCOUNT asc, MATCONN asc
sort filtered8 unstable by TIME asc, MATCONN asc, MAT_GROUP_ID asc
sort filtered10 unstable by TIME asc, MATCONN asc
for revenue12 in group3
find found13 = filtered10 where TIME = revenue12.TIME and MATCONN = revenue12.MATCONN search binary missing initial
if found(found13)
let mapped15 = ""
for product14 in product_members
if matches(product14.ID, "PRODUCT_TYPE_+++")
if integer(slice(product14.ID, 13, 3)) == integer(found13.SIGNEDDATA)
mapped15 = text(product14.ID)
break
end
end
end
if mapped15 != ""
revenue12.PRODUCT_TYPE = mapped15
else
revenue12.PRODUCT_TYPE = found13.PRODUCT_TYPE
end
end
find found16 = product_members where ID = revenue12.PRODUCT_TYPE search linear missing initial
revenue12.REV_ID_GROUP = found16.REV_ID_GROUP
find found17 = conn_reg_split where TIME = revenue12.TIME and ACCOUNT = revenue12.ACCOUNT search binary missing initial
if found(found17)
revenue12.CONN_REG_SPLIT = found17.CONN_REG_SPLIT
end
find found18 = l1_l2_mapping where TIME = revenue12.TIME and ACCOUNT = revenue12.ACCOUNT search binary missing initial
if found(found18)
revenue12.FFLAS_SUBSET = found18.FFLAS_SUBSET
end
find found19 = filtered6 where TIME = revenue12.TIME and ACCOUNT = revenue12.ACCOUNT and MATCONN = revenue12.MATCONN search binary missing initial
if found(found19)
revenue12.MATREMAP = found19.MATREMAP
else
find found20 = filtered6 where TIME = revenue12.TIME and ACCOUNT = "ACCOUNT_NA" and MATCONN = revenue12.MATCONN search binary missing initial
if found(found20)
revenue12.MATREMAP = found20.MATREMAP
else
if revenue12.MATCONN == "MATCONN_NA"
revenue12.MATREMAP = "MATREMAP_NA"
else
revenue12.MATREMAP = revenue12.MATCONN
end
end
end
if revenue12.PRODUCT_TYPE == "PRODUCT_TYPE_NA" and revenue12.MATREMAP != "MATREMAP_NA"
find found21 = material_members where ID = revenue12.MATREMAP search linear missing initial
revenue12.PRODUCT_TYPE = found21.PRODUCT_TYPE
end
if revenue12.MATREMAP != "MATREMAP_NA"
find found22 = mat_group_mapping where TIME = revenue12.TIME and MATCONN = revenue12.MATREMAP and ACCOUNT = "ACCOUNT_NA" search binary missing initial
if found(found22)
revenue12.MAT_GROUP_ID = found22.MAT_GROUP_ID
end
else
find found23 = mat_group_mapping where TIME = revenue12.TIME and MATCONN = "MATCONN_NA" and ACCOUNT = revenue12.ACCOUNT search binary missing initial
if found(found23)
revenue12.MAT_GROUP_ID = found23.MAT_GROUP_ID
end
end
find found24 = group_members where ID = revenue12.MAT_GROUP_ID search linear missing initial
if not initial(found24.REV_ID_GROUP)
revenue12.REV_ID_GROUP = found24.REV_ID_GROUP
end
find found25 = filtered8 where TIME = revenue12.TIME and MATCONN = "MATCONN_NA" and MAT_GROUP_ID = revenue12.MAT_GROUP_ID search binary missing initial
if found(found25)
revenue12.REG_FFLAS_SERV = found25.REG_FFLAS_SERV
else
find found26 = filtered8 where TIME = revenue12.TIME and MATCONN = revenue12.MATREMAP search binary missing initial
if found(found26)
revenue12.REG_FFLAS_SERV = found26.REG_FFLAS_SERV
end
end
end
append new_data from group3
publish new_data as "NEW_DATA"
group group27 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
for g28 in group27
if initial(g28.ACCOUNT)
g28.ACCOUNT = "ACCOUNT_NA"
end
if initial(g28.AUDITTRAIL)
g28.AUDITTRAIL = "AUDITTRAIL_NA"
end
if initial(g28.CATEGORY)
g28.CATEGORY = "CATEGORY_NA"
end
if initial(g28.COSTCENTRE)
g28.COSTCENTRE = "COSTCENTRE_NA"
end
if initial(g28.DEMREVID_KFS)
g28.DEMREVID_KFS = "DEMREVID_KFS_NA"
end
if initial(g28.FFLAS)
g28.FFLAS = "FFLAS_NA"
end
if initial(g28.FFLAS_SUBSET)
g28.FFLAS_SUBSET = "FFLAS_SUBSET_NA"
end
if initial(g28.MATCONN)
g28.MATCONN = "MATCONN_NA"
end
if initial(g28.TIME)
g28.TIME = "TIME_NA"
end
if initial(g28.PRODUCT_TYPE)
g28.PRODUCT_TYPE = "PRODUCT_TYPE_NA"
end
if initial(g28.GEO_DRIVERS)
g28.GEO_DRIVERS = "GDRVS_NA"
end
if initial(g28.DOC_TYP)
g28.DOC_TYP = "DOC_TYP_NA"
end
if initial(g28.CONN_REG_SPLIT)
g28.CONN_REG_SPLIT = "CONN_REG_SPLIT_NA"
end
if initial(g28.LFC_WIN_SUPPLIER)
g28.LFC_WIN_SUPPLIER = "LFC_WIN_SUPPLIER_NA"
end
if initial(g28.MAT_GROUP_ID)
g28.MAT_GROUP_ID = "MAT_GROUP_ID_NA"
end
if initial(g28.REG_FFLAS_SERV)
g28.REG_FFLAS_SERV = "REG_FFLAS_SERV_NA"
end
if initial(g28.UFB_DR_ID)
g28.UFB_DR_ID = "UFB_DR_ID_NA"
end
if initial(g28.MATREMAP)
g28.MATREMAP = "MATREMAP_NA"
end
if initial(g28.RSP_SERVICE_ID)
g28.RSP_SERVICE_ID = "RSP_SERVICE_ID_NA"
end
if initial(g28.REV_ID_GROUP)
g28.REV_ID_GROUP = "REV_ID_GROUP_NA"
end
end
sort group27 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
show group27 as "CONTROL_TOTALS"
