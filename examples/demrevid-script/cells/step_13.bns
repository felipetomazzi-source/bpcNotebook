script version 2 compact
dataset new_data = "step_12" named "NEW_DATA"
empty supplier_ratios = new_data
dataset rsp_supplier_material_ratio = "step_01" named "RSP_SUPPLIER_MATERIAL_RATIO"
dataset rsp_supplier_gl_ratio = "step_01" named "RSP_SUPPLIER_GL_RATIO"
dataset cal_supplier_gl_ratio = "step_01" named "CAL_SUPPLIER_GL_RATIO"
dataset cal_supplier_conn_seg_ratio = "step_01" named "CAL_SUPPLIER_CONN_SEG_RATIO"
filter filtered1 = new_data as f2 where f2.DEMREVID_KFS == "DEMREVID028"
index ix4 = rsp_supplier_material_ratio by ["TIME","ACCOUNT","MATCONN"] many
index ix8 = rsp_supplier_gl_ratio by ["ACCOUNT","TIME"] many
index ix12 = cal_supplier_gl_ratio by ["ACCOUNT","TIME"] many
index ix16 = cal_supplier_conn_seg_ratio by ["CONN_REG_SPLIT","TIME"] many
for selected3 in filtered1 copy
selected3.DEMREVID_KFS = "DEMREVID033"
if integer(selected3.SIGNEDDATA) == 1
match matches5 = ix4 where TIME = selected3.TIME and ACCOUNT = selected3.ACCOUNT and MATCONN = selected3.MATCONN
for ratio6 in matches5
copy row7 = selected3
row7.LFC_WIN_SUPPLIER = ratio6.LFC_WIN_SUPPLIER
row7.SIGNEDDATA = ratio6.SIGNEDDATA
append supplier_ratios row row7
end
end
if integer(selected3.SIGNEDDATA) == 2
match matches9 = ix8 where ACCOUNT = selected3.ACCOUNT and TIME = selected3.TIME
for ratio10 in matches9
copy row11 = selected3
row11.LFC_WIN_SUPPLIER = ratio10.LFC_WIN_SUPPLIER
row11.SIGNEDDATA = ratio10.SIGNEDDATA
append supplier_ratios row row11
end
end
if integer(selected3.SIGNEDDATA) == 3
match matches13 = ix12 where ACCOUNT = selected3.ACCOUNT and TIME = selected3.TIME
for ratio14 in matches13
copy row15 = selected3
row15.LFC_WIN_SUPPLIER = ratio14.LFC_WIN_SUPPLIER
row15.SIGNEDDATA = ratio14.SIGNEDDATA
append supplier_ratios row row15
end
end
if integer(selected3.SIGNEDDATA) == 4
match matches17 = ix16 where CONN_REG_SPLIT = selected3.CONN_REG_SPLIT and TIME = selected3.TIME
for ratio18 in matches17
copy row19 = selected3
row19.LFC_WIN_SUPPLIER = ratio18.LFC_WIN_SUPPLIER
row19.SIGNEDDATA = ratio18.SIGNEDDATA
append supplier_ratios row row19
end
end
end
sort supplier_ratios unstable by TIME asc, ACCOUNT asc, MATCONN asc
append new_data from supplier_ratios
publish new_data as "NEW_DATA"
publish supplier_ratios as "SUPPLIER_RATIOS"
group group20 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
defaults group20 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group20 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
show group20 as "CONTROL_TOTALS"
