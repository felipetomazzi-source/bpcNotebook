g71.COSTCENTRE = "COSTCENTRE_NA"
end
if initial(g71.DEMREVID_KFS)
g71.DEMREVID_KFS = "DEMREVID_KFS_NA"
end
if initial(g71.FFLAS)
g71.FFLAS = "FFLAS_NA"
end
if initial(g71.FFLAS_SUBSET)
g71.FFLAS_SUBSET = "FFLAS_SUBSET_NA"
end
if initial(g71.MATCONN)
g71.MATCONN = "MATCONN_NA"
end
if initial(g71.TIME)
g71.TIME = "TIME_NA"
end
if initial(g71.PRODUCT_TYPE)
g71.PRODUCT_TYPE = "PRODUCT_TYPE_NA"
end
if initial(g71.GEO_DRIVERS)
g71.GEO_DRIVERS = "GDRVS_NA"
end
if initial(g71.DOC_TYP)
g71.DOC_TYP = "DOC_TYP_NA"
end
if initial(g71.CONN_REG_SPLIT)
g71.CONN_REG_SPLIT = "CONN_REG_SPLIT_NA"
end
if initial(g71.LFC_WIN_SUPPLIER)
g71.LFC_WIN_SUPPLIER = "LFC_WIN_SUPPLIER_NA"
end
if initial(g71.MAT_GROUP_ID)
g71.MAT_GROUP_ID = "MAT_GROUP_ID_NA"
end
if initial(g71.REG_FFLAS_SERV)
g71.REG_FFLAS_SERV = "REG_FFLAS_SERV_NA"
end
if initial(g71.UFB_DR_ID)
g71.UFB_DR_ID = "UFB_DR_ID_NA"
end
if initial(g71.MATREMAP)
g71.MATREMAP = "MATREMAP_NA"
end
if initial(g71.RSP_SERVICE_ID)
g71.RSP_SERVICE_ID = "RSP_SERVICE_ID_NA"
end
if initial(g71.REV_ID_GROUP)
g71.REV_ID_GROUP = "REV_ID_GROUP_NA"
end
end
sort group70 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
show group70 as "CONTROL_TOTALS"
