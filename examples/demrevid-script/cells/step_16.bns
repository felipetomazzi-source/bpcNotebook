script version 2 compact
dataset new_data = "step_15" named "NEW_DATA"
dataset input_data = "step_01" named "INPUT_DATA"
dataset sap_revenues = "step_02" named "SAP_REVENUES"
filter filtered1 = new_data as f2 where f2.DEMREVID_KFS == "DEMREVID023" and f2.ACCOUNT == "001054200" and is_in(f2.PRODUCT_TYPE,["PRODUCT_TYPE_001","PRODUCT_TYPE_004"])
for replace3 in filtered1
replace3.AUDITTRAIL = "DEMREVID_CALC_HSNS_CREDIT"
end
for credit_row in filtered1
credit_row.SIGNEDDATA = credit_row.SIGNEDDATA * -1
end
append new_data from filtered1
filter filtered4 = input_data as f5 where f5.DEMREVID_KFS == "DEMREVID045"
for replace6 in filtered4
replace6.AUDITTRAIL = "DEMREVID_CALC_HSNS"
replace6.DEMREVID_KFS = "DEMREVID006"
end
group group7 = filtered4 exclude ["UFB_DR_ID"]
defaults group7 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group7 unstable by UFB_DR_ID asc
dataset conn_reg_split = "step_01" named "CONN_REG_SPLIT"
dataset l1_l2_mapping = "step_01" named "L1_L2_MAPPING"
dataset mat_group_mapping = "step_01" named "MAT_GROUP_MAPPING"
dataset product_members = "step_01" named "PRODUCT_MEMBERS"
dataset material_members = "step_01" named "MATERIAL_MEMBERS"
dataset group_members = "step_01" named "GROUP_MEMBERS"
filter filtered8 = input_data as f9 where f9.DEMREVID_KFS == "DEMREVID036"
filter filtered10 = input_data as f11 where f11.DEMREVID_KFS == "DEMREVID037"
filter filtered12 = input_data as f13 where f13.DEMREVID_KFS == "DEMREVID014"
sort filtered8 unstable by TIME asc, ACCOUNT asc, MATCONN asc
sort filtered10 unstable by TIME asc, MATCONN asc, MAT_GROUP_ID asc
sort filtered12 unstable by TIME asc, MATCONN asc
index ix17 = product_members by ["ID"] many
index ix24 = material_members by ["ID"] many
index ix28 = group_members by ["ID"] many
for revenue14 in group7
find found15 = filtered12 where TIME = revenue14.TIME and MATCONN = revenue14.MATCONN search binary missing initial
if found(found15)
lookup found16 = ix17 where ID = concat("PRODUCT_TYPE_", numeric_text(found15.SIGNEDDATA,3)) policy first missing initial
if found(found16)
revenue14.PRODUCT_TYPE = found16.ID
else
revenue14.PRODUCT_TYPE = found15.PRODUCT_TYPE
end
end
lookup found18 = ix17 where ID = revenue14.PRODUCT_TYPE policy first missing initial
revenue14.REV_ID_GROUP = found18.REV_ID_GROUP
find found19 = conn_reg_split where TIME = revenue14.TIME and ACCOUNT = revenue14.ACCOUNT search binary missing initial
if found(found19)
revenue14.CONN_REG_SPLIT = found19.CONN_REG_SPLIT
end
find found20 = l1_l2_mapping where TIME = revenue14.TIME and ACCOUNT = revenue14.ACCOUNT search binary missing initial
if found(found20)
revenue14.FFLAS_SUBSET = found20.FFLAS_SUBSET
end
find found21 = filtered8 where TIME = revenue14.TIME and ACCOUNT = revenue14.ACCOUNT and MATCONN = revenue14.MATCONN search binary missing initial
if found(found21)
revenue14.MATREMAP = found21.MATREMAP
else
find found22 = filtered8 where TIME = revenue14.TIME and ACCOUNT = "ACCOUNT_NA" and MATCONN = revenue14.MATCONN search binary missing initial
if found(found22)
revenue14.MATREMAP = found22.MATREMAP
else
if revenue14.MATCONN == "MATCONN_NA"
revenue14.MATREMAP = "MATREMAP_NA"
else
revenue14.MATREMAP = revenue14.MATCONN
end
end
end
if revenue14.PRODUCT_TYPE == "PRODUCT_TYPE_NA" and revenue14.MATREMAP != "MATREMAP_NA"
lookup found23 = ix24 where ID = revenue14.MATREMAP policy first missing initial
revenue14.PRODUCT_TYPE = found23.PRODUCT_TYPE
end
if revenue14.MATREMAP != "MATREMAP_NA"
find found25 = mat_group_mapping where TIME = revenue14.TIME and MATCONN = revenue14.MATREMAP and ACCOUNT = "ACCOUNT_NA" search binary missing initial
if found(found25)
revenue14.MAT_GROUP_ID = found25.MAT_GROUP_ID
end
else
find found26 = mat_group_mapping where TIME = revenue14.TIME and MATCONN = "MATCONN_NA" and ACCOUNT = revenue14.ACCOUNT search binary missing initial
if found(found26)
revenue14.MAT_GROUP_ID = found26.MAT_GROUP_ID
end
end
lookup found27 = ix28 where ID = revenue14.MAT_GROUP_ID policy first missing initial
if not initial(found27.REV_ID_GROUP)
revenue14.REV_ID_GROUP = found27.REV_ID_GROUP
end
find found29 = filtered10 where TIME = revenue14.TIME and MATCONN = "MATCONN_NA" and MAT_GROUP_ID = revenue14.MAT_GROUP_ID search binary missing initial
if found(found29)
revenue14.REG_FFLAS_SERV = found29.REG_FFLAS_SERV
else
find found30 = filtered10 where TIME = revenue14.TIME and MATCONN = revenue14.MATREMAP search binary missing initial
if found(found30)
revenue14.REG_FFLAS_SERV = found30.REG_FFLAS_SERV
end
end
end
sort group7 unstable by TIME asc, RSP_SERVICE_ID asc, PRODUCT_TYPE asc, FFLAS asc
for bandwidth_row in group7
if bandwidth_row.PRODUCT_TYPE == "PRODUCT_TYPE_004"
find found31 = group7 where TIME = bandwidth_row.TIME and RSP_SERVICE_ID = bandwidth_row.RSP_SERVICE_ID and PRODUCT_TYPE = "PRODUCT_TYPE_001" and FFLAS = bandwidth_row.FFLAS search linear missing initial
if found(found31)
bandwidth_row.MAT_GROUP_ID = found31.MAT_GROUP_ID
bandwidth_row.RSP_SERVICE_ID = "RSP_SERVICE_ID_NA"
end
end
end
group group32 = group7 all
append new_data from group32
copy hsns_fflas_allocation = group32
for replace33 in hsns_fflas_allocation
replace33.DEMREVID_KFS = "DEMREVID023"
end
group group34 = hsns_fflas_allocation all
let raw35 = input("HSNS_REALLOC_LOCATIONS")
let parts36 = split(raw35,",")
table range37 columns ID member
row range_row38 like range37
for value39 in parts36
range_row38.ID = no_gaps(value39)
append range37 row range_row38
end
sort range37 unstable by ID asc
deduplicate range37 adjacent by ["ID"]
copy eligible = group32
for eligible_row in eligible
if eligible_row.FFLAS == "FFLASID"
find found40 = range37 where ID = eligible_row.LFC_WIN_SUPPLIER search linear missing initial
if not found(found40)
delete eligible_row
end
end
end
group group41 = eligible include ["TIME","MATCONN","FFLAS","LFC_WIN_SUPPLIER"]
defaults group41 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group41 unstable by TIME asc, MATCONN asc, FFLAS asc, LFC_WIN_SUPPLIER asc
group group42 = group41 include ["TIME","MATCONN"]
defaults group42 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group42 unstable by TIME asc, MATCONN asc
for divide43 in group41
find found44 = group42 where TIME = divide43.TIME and MATCONN = divide43.MATCONN search binary missing initial
divide divide43.SIGNEDDATA by found44.SIGNEDDATA using float onzero keep
end
group group45 = group41 include ["TIME","MATCONN"]
defaults group45 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group45 unstable by TIME asc, MATCONN asc
sort group41 unstable by TIME asc, MATCONN asc
for sum46 in group45
if sum46.SIGNEDDATA != 1 and not initial(sum46.SIGNEDDATA)
find found47 = group41 where TIME = sum46.TIME and MATCONN = sum46.MATCONN search linear missing initial
if found(found47)
found47.SIGNEDDATA = found47.SIGNEDDATA + (1 - sum46.SIGNEDDATA)
end
end
end
group group48 = eligible include ["TIME","MAT_GROUP_ID","FFLAS","LFC_WIN_SUPPLIER"]
defaults group48 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group48 unstable by TIME asc, MAT_GROUP_ID asc, FFLAS asc, LFC_WIN_SUPPLIER asc
group group49 = group48 include ["TIME","MAT_GROUP_ID"]
defaults group49 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group49 unstable by TIME asc, MAT_GROUP_ID asc
for divide50 in group48
find found51 = group49 where TIME = divide50.TIME and MAT_GROUP_ID = divide50.MAT_GROUP_ID search binary missing initial
divide divide50.SIGNEDDATA by found51.SIGNEDDATA using float onzero keep
end
group group52 = group48 include ["TIME","MAT_GROUP_ID"]
defaults group52 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group52 unstable by TIME asc, MAT_GROUP_ID asc
sort group48 unstable by TIME asc, MAT_GROUP_ID asc
for sum53 in group52
if sum53.SIGNEDDATA != 1 and not initial(sum53.SIGNEDDATA)
find found54 = group48 where TIME = sum53.TIME and MAT_GROUP_ID = sum53.MAT_GROUP_ID search linear missing initial
if found(found54)
found54.SIGNEDDATA = found54.SIGNEDDATA + (1 - sum53.SIGNEDDATA)
end
end
end
filter filtered55 = sap_revenues as f56 where f56.ACCOUNT == "001054200" and is_in(f56.PRODUCT_TYPE,["PRODUCT_TYPE_001","PRODUCT_TYPE_004"]) and f56.DEMREVID_KFS == "DEMREVID007"
for replace57 in filtered55
replace57.AUDITTRAIL = "DEMREVID_CALC_HSNS"
end
empty accrual_allocation = new_data
index ix59 = group41 by ["TIME","MATCONN"] many
index ix63 = group48 by ["TIME","MAT_GROUP_ID"] many
for accrued in filtered55
find found58 = group41 where TIME = accrued.TIME and MATCONN = accrued.MATCONN search linear missing initial
if found(found58)
match matches60 = ix59 where TIME = accrued.TIME and MATCONN = accrued.MATCONN
for ratio61 in matches60
copy row62 = accrued
row62.LFC_WIN_SUPPLIER = ratio61.LFC_WIN_SUPPLIER
row62.FFLAS = ratio61.FFLAS
row62.SIGNEDDATA = accrued.SIGNEDDATA * ratio61.SIGNEDDATA
append accrual_allocation row row62
end
else
match matches64 = ix63 where TIME = accrued.TIME and MAT_GROUP_ID = accrued.MAT_GROUP_ID
for ratio65 in matches64
copy row66 = accrued
row66.LFC_WIN_SUPPLIER = ratio65.LFC_WIN_SUPPLIER
row66.FFLAS = ratio65.FFLAS
row66.SIGNEDDATA = accrued.SIGNEDDATA * ratio65.SIGNEDDATA
append accrual_allocation row row66
end
end
end
append new_data from accrual_allocation
append group34 from accrual_allocation
for replace67 in group34
replace67.DEMREVID_KFS = "DEMREVID023"
end
group group68 = group34 all
append new_data from group68
publish new_data as "NEW_DATA"
group group69 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
defaults group69 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group69 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
show group69 as "CONTROL_TOTALS"
