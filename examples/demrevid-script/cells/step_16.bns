row70.LFC_WIN_SUPPLIER = ratio69.LFC_WIN_SUPPLIER
row70.FFLAS = ratio69.FFLAS
row70.SIGNEDDATA = accrued.SIGNEDDATA * ratio69.SIGNEDDATA
append accrual_allocation row row70
end
else
match matches72 = ix71 where TIME = accrued.TIME and MAT_GROUP_ID = accrued.MAT_GROUP_ID
for ratio73 in matches72
copy row74 = accrued
row74.LFC_WIN_SUPPLIER = ratio73.LFC_WIN_SUPPLIER
row74.FFLAS = ratio73.FFLAS
row74.SIGNEDDATA = accrued.SIGNEDDATA * ratio73.SIGNEDDATA
append accrual_allocation row row74
end
end
end
append new_data from accrual_allocation
append group33 from accrual_allocation
for replace75 in group33
replace75.DEMREVID_KFS = "DEMREVID023"
end
group group76 = group33 all
append new_data from group76
publish new_data as "NEW_DATA"
group group77 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
for g78 in group77
if initial(g78.ACCOUNT)
g78.ACCOUNT = "ACCOUNT_NA"
end
if initial(g78.AUDITTRAIL)
g78.AUDITTRAIL = "AUDITTRAIL_NA"
end
if initial(g78.CATEGORY)
g78.CATEGORY = "CATEGORY_NA"
end
if initial(g78.COSTCENTRE)
g78.COSTCENTRE = "COSTCENTRE_NA"
end
if initial(g78.DEMREVID_KFS)
g78.DEMREVID_KFS = "DEMREVID_KFS_NA"
end
if initial(g78.FFLAS)
g78.FFLAS = "FFLAS_NA"
end
if initial(g78.FFLAS_SUBSET)
g78.FFLAS_SUBSET = "FFLAS_SUBSET_NA"
end
if initial(g78.MATCONN)
g78.MATCONN = "MATCONN_NA"
end
if initial(g78.TIME)
g78.TIME = "TIME_NA"
end
if initial(g78.PRODUCT_TYPE)
g78.PRODUCT_TYPE = "PRODUCT_TYPE_NA"
end
if initial(g78.GEO_DRIVERS)
g78.GEO_DRIVERS = "GDRVS_NA"
end
if initial(g78.DOC_TYP)
g78.DOC_TYP = "DOC_TYP_NA"
end
if initial(g78.CONN_REG_SPLIT)
g78.CONN_REG_SPLIT = "CONN_REG_SPLIT_NA"
end
if initial(g78.LFC_WIN_SUPPLIER)
g78.LFC_WIN_SUPPLIER = "LFC_WIN_SUPPLIER_NA"
end
if initial(g78.MAT_GROUP_ID)
g78.MAT_GROUP_ID = "MAT_GROUP_ID_NA"
end
if initial(g78.REG_FFLAS_SERV)
g78.REG_FFLAS_SERV = "REG_FFLAS_SERV_NA"
end
if initial(g78.UFB_DR_ID)
g78.UFB_DR_ID = "UFB_DR_ID_NA"
end
if initial(g78.MATREMAP)
g78.MATREMAP = "MATREMAP_NA"
end
if initial(g78.RSP_SERVICE_ID)
g78.RSP_SERVICE_ID = "RSP_SERVICE_ID_NA"
end
if initial(g78.REV_ID_GROUP)
g78.REV_ID_GROUP = "REV_ID_GROUP_NA"
end
end
sort group77 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
show group77 as "CONTROL_TOTALS"
