script version 2
dataset new_data = "step_15" named "NEW_DATA"
dataset input_data = "step_01" named "INPUT_DATA"
dataset sap_revenues = "step_02" named "SAP_REVENUES"
filter filtered1 = new_data as f2 where f2.DEMREVID_KFS == "DEMREVID023" and f2.ACCOUNT == "001054200" and is_in(f2.PRODUCT_TYPE,["PRODUCT_TYPE_001","PRODUCT_TYPE_004"])
for replace3 in filtered1
