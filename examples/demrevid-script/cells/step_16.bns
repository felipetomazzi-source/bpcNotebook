filter filtered9 = input_data as f10 where f10.DEMREVID_KFS == "DEMREVID036"
filter filtered11 = input_data as f12 where f12.DEMREVID_KFS == "DEMREVID037"
filter filtered13 = input_data as f14 where f14.DEMREVID_KFS == "DEMREVID014"
