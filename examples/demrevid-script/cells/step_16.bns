sort filtered13 unstable by TIME asc, MATCONN asc
for revenue15 in group7
find found16 = filtered13 where TIME = revenue15.TIME and MATCONN = revenue15.MATCONN search binary missing initial
if found(found16)
let mapped18 = ""
for product17 in product_members
if matches(product17.ID, "PRODUCT_TYPE_+++")
if integer(slice(product17.ID, 13, 3)) == integer(found16.SIGNEDDATA)
mapped18 = text(product17.ID)
break
end
end
end
if mapped18 != ""
revenue15.PRODUCT_TYPE = mapped18
else
revenue15.PRODUCT_TYPE = found16.PRODUCT_TYPE
end
end
find found19 = product_members where ID = revenue15.PRODUCT_TYPE search linear missing initial
revenue15.REV_ID_GROUP = found19.REV_ID_GROUP
find found20 = conn_reg_split where TIME = revenue15.TIME and ACCOUNT = revenue15.ACCOUNT search binary missing initial
if found(found20)
revenue15.CONN_REG_SPLIT = found20.CONN_REG_SPLIT
end
find found21 = l1_l2_mapping where TIME = revenue15.TIME and ACCOUNT = revenue15.ACCOUNT search binary missing initial
if found(found21)
revenue15.FFLAS_SUBSET = found21.FFLAS_SUBSET
end
find found22 = filtered9 where TIME = revenue15.TIME and ACCOUNT = revenue15.ACCOUNT and MATCONN = revenue15.MATCONN search binary missing initial
if found(found22)
revenue15.MATREMAP = found22.MATREMAP
else
find found23 = filtered9 where TIME = revenue15.TIME and ACCOUNT = "ACCOUNT_NA" and MATCONN = revenue15.MATCONN search binary missing initial
if found(found23)
revenue15.MATREMAP = found23.MATREMAP
else
if revenue15.MATCONN == "MATCONN_NA"
revenue15.MATREMAP = "MATREMAP_NA"
else
revenue15.MATREMAP = revenue15.MATCONN
end
end
end
if revenue15.PRODUCT_TYPE == "PRODUCT_TYPE_NA" and revenue15.MATREMAP != "MATREMAP_NA"
find found24 = material_members where ID = revenue15.MATREMAP search linear missing initial
revenue15.PRODUCT_TYPE = found24.PRODUCT_TYPE
end
if revenue15.MATREMAP != "MATREMAP_NA"
find found25 = mat_group_mapping where TIME = revenue15.TIME and MATCONN = revenue15.MATREMAP and ACCOUNT = "ACCOUNT_NA" search binary missing initial
if found(found25)
revenue15.MAT_GROUP_ID = found25.MAT_GROUP_ID
end
else
find found26 = mat_group_mapping where TIME = revenue15.TIME and MATCONN = "MATCONN_NA" and ACCOUNT = revenue15.ACCOUNT search binary missing initial
if found(found26)
revenue15.MAT_GROUP_ID = found26.MAT_GROUP_ID
end
end
find found27 = group_members where ID = revenue15.MAT_GROUP_ID search linear missing initial
if not initial(found27.REV_ID_GROUP)
revenue15.REV_ID_GROUP = found27.REV_ID_GROUP
end
find found28 = filtered11 where TIME = revenue15.TIME and MATCONN = "MATCONN_NA" and MAT_GROUP_ID = revenue15.MAT_GROUP_ID search binary missing initial
if found(found28)
revenue15.REG_FFLAS_SERV = found28.REG_FFLAS_SERV
else
