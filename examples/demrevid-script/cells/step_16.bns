empty accrual_allocation = new_data
index ix60 = group36 by ["TIME","MATCONN"] many
index ix64 = group46 by ["TIME","MAT_GROUP_ID"] many
for accrued in filtered56
find found59 = group36 where TIME = accrued.TIME and MATCONN = accrued.MATCONN search linear missing initial
if found(found59)
match matches61 = ix60 where TIME = accrued.TIME and MATCONN = accrued.MATCONN
for ratio62 in matches61
copy row63 = accrued
row63.LFC_WIN_SUPPLIER = ratio62.LFC_WIN_SUPPLIER
row63.FFLAS = ratio62.FFLAS
row63.SIGNEDDATA = accrued.SIGNEDDATA * ratio62.SIGNEDDATA
append accrual_allocation row row63
end
else
match matches65 = ix64 where TIME = accrued.TIME and MAT_GROUP_ID = accrued.MAT_GROUP_ID
for ratio66 in matches65
copy row67 = accrued
row67.LFC_WIN_SUPPLIER = ratio66.LFC_WIN_SUPPLIER
row67.FFLAS = ratio66.FFLAS
row67.SIGNEDDATA = accrued.SIGNEDDATA * ratio66.SIGNEDDATA
append accrual_allocation row row67
end
end
end
append new_data from accrual_allocation
append group33 from accrual_allocation
for replace68 in group33
replace68.DEMREVID_KFS = "DEMREVID023"
end
group group69 = group33 all
append new_data from group69
publish new_data as "NEW_DATA"
group group70 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
for g71 in group70
if initial(g71.ACCOUNT)
g71.ACCOUNT = "ACCOUNT_NA"
end
if initial(g71.AUDITTRAIL)
g71.AUDITTRAIL = "AUDITTRAIL_NA"
end
if initial(g71.CATEGORY)
g71.CATEGORY = "CATEGORY_NA"
end
