script version 2 compact
// DEMREVID003 business-rule notes
// Choose the supplier driver
// Choose RSP material/account supplier ratios before CAL supplier ratios, preserving the original lookup
// keys and waterfall order. Store the chosen method separately.
// Check: Trace a material-specific match, account fallback, CAL fallback and no-match.
// Complete working tables stay in SAP; displayed previews are not calculation inputs.

// Read the complete SAP_REVENUES_CONSOL working table retained by step_03.
dataset sap_revenues_consol = "step_03" named "SAP_REVENUES_CONSOL"
// Read the complete NEW_DATA working table retained by step_11.
dataset new_data = "step_11" named "NEW_DATA"
// Read the complete RSP_SUPPLIER_MATERIAL_RATIO working table retained by step_01.
dataset rsp_supplier_material_ratio = "step_01" named "RSP_SUPPLIER_MATERIAL_RATIO"
// Read the complete RSP_SUPPLIER_GL_RATIO working table retained by step_01.
dataset rsp_supplier_gl_ratio = "step_01" named "RSP_SUPPLIER_GL_RATIO"
// Read the complete CAL_SUPPLIER_GL_RATIO working table retained by step_01.
dataset cal_supplier_gl_ratio = "step_01" named "CAL_SUPPLIER_GL_RATIO"
// Read the complete CAL_SUPPLIER_CONN_SEG_RATIO working table retained by step_01.
dataset cal_supplier_conn_seg_ratio = "step_01" named "CAL_SUPPLIER_CONN_SEG_RATIO"
for base1 in sap_revenues_consol copy
base1.DEMREVID_KFS = "DEMREVID028"
let method2 = 5
if method2 == 5
// A missing lookup returns initial values; the following found checks and fallback branches control the outcome.
find found3 = rsp_supplier_material_ratio where TIME = base1.TIME and ACCOUNT = base1.ACCOUNT and MATCONN = base1.MATCONN search binary missing initial
if found(found3)
method2 = 1
end
end
if method2 == 5
find found4 = rsp_supplier_gl_ratio where TIME = base1.TIME and ACCOUNT = base1.ACCOUNT search binary missing initial
if found(found4)
method2 = 2
end
end
if method2 == 5
find found5 = cal_supplier_gl_ratio where TIME = base1.TIME and ACCOUNT = base1.ACCOUNT search binary missing initial
if found(found5)
method2 = 3
end
end
if method2 == 5
find found6 = cal_supplier_conn_seg_ratio where TIME = base1.TIME and CONN_REG_SPLIT = base1.CONN_REG_SPLIT search binary missing initial
if found(found6)
method2 = 4
end
end
base1.SIGNEDDATA = integer(method2)
append new_data row base1
end
// Retain complete native datasets for downstream stages; publication here does not post financial data.
publish new_data as "NEW_DATA"
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group7 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
// Fill initial dimensions with their original NA members; GEO_DRIVERS uses GDRVS_NA.
defaults group7 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
// Preserve the original sort keys and tie behavior used by subsequent lookups.
sort group7 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
// Display a bounded sample for review; source totals and complete SAP working datasets remain separate.
show group7 as "CONTROL_TOTALS"
