additional.SIGNEDDATA = found80.SIGNEDDATA
if not initial(additional.SIGNEDDATA)
append additional_connections row additional
copy row81 = additional
row81.DEMREVID_KFS = "DEMREVID049"
append additional_connections row row81
end
end
if additional.DEMREVID_KFS == "DEMREVID040"
find found82 = filtered76 where TIME = additional.TIME and FFLAS = additional.FFLAS and MAT_GROUP_ID = additional.MAT_GROUP_ID search binary missing initial
additional.SIGNEDDATA = found82.SIGNEDDATA
if not initial(additional.SIGNEDDATA)
append additional_connections row additional
end
end
end
for adjustment in additional_connections
find found83 = transposed_conn where ACCOUNT = adjustment.ACCOUNT and AUDITTRAIL = adjustment.AUDITTRAIL and CATEGORY = adjustment.CATEGORY and COSTCENTRE = adjustment.COSTCENTRE and DEMREVID_KFS = adjustment.DEMREVID_KFS and FFLAS = adjustment.FFLAS and FFLAS_SUBSET = adjustment.FFLAS_SUBSET and MATCONN = adjustment.MATCONN and TIME = adjustment.TIME and PRODUCT_TYPE = adjustment.PRODUCT_TYPE and GEO_DRIVERS = adjustment.GEO_DRIVERS and DOC_TYP = adjustment.DOC_TYP and CONN_REG_SPLIT = adjustment.CONN_REG_SPLIT and LFC_WIN_SUPPLIER = adjustment.LFC_WIN_SUPPLIER and MAT_GROUP_ID = adjustment.MAT_GROUP_ID and REG_FFLAS_SERV = adjustment.REG_FFLAS_SERV and UFB_DR_ID = adjustment.UFB_DR_ID and MATREMAP = adjustment.MATREMAP and RSP_SERVICE_ID = adjustment.RSP_SERVICE_ID and REV_ID_GROUP = adjustment.REV_ID_GROUP search linear missing initial
if found(found83)
found83.SIGNEDDATA = found83.SIGNEDDATA + adjustment.SIGNEDDATA
else
append transposed_conn row adjustment
end
end
sort transposed_conn unstable by ACCOUNT asc, AUDITTRAIL asc, CATEGORY asc, COSTCENTRE asc, DEMREVID_KFS asc, FFLAS asc, FFLAS_SUBSET asc, MATCONN asc, TIME asc, PRODUCT_TYPE asc, GEO_DRIVERS asc, DOC_TYP asc, CONN_REG_SPLIT asc, LFC_WIN_SUPPLIER asc, MAT_GROUP_ID asc, REG_FFLAS_SERV asc, UFB_DR_ID asc, MATREMAP asc, RSP_SERVICE_ID asc, REV_ID_GROUP asc
append new_data from transposed_conn
end
publish new_data as "NEW_DATA"
publish transposed_revenues as "TRANSPOSED_REVENUES"
group group84 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
for g85 in group84
