script version 2 compact
// DEMREVID003 business-rule notes
// Attach SAP prices to materials
// Match SAP prices to consolidated revenues by time and material. Emit the original price key figure and
// native amount for each matched row.
// Check: Trace matched and unmatched prices without treating price totals as revenue totals.
// Complete working tables stay in SAP; displayed previews are not calculation inputs.

// Read the complete INPUT_DATA working table retained by step_01.
dataset input_data = "step_01" named "INPUT_DATA"
// Read the complete NEW_DATA working table retained by step_14.
dataset new_data = "step_14" named "NEW_DATA"
// Read the complete SAP_REVENUES_CONSOL working table retained by step_03.
dataset sap_revenues_consol = "step_03" named "SAP_REVENUES_CONSOL"
// Select the records required by this business block; retain their original signs and dimensions.
filter filtered1 = input_data as f2 where f2.DEMREVID_KFS == "DEMREVID002"
// Preserve the original sort keys and tie behavior used by subsequent lookups.
sort filtered1 unstable by TIME asc, MATCONN asc
for revenue in sap_revenues_consol copy
// A missing lookup returns initial values; the following found checks and fallback branches control the outcome.
find found3 = filtered1 where TIME = revenue.TIME and MATCONN = revenue.MATCONN search binary missing initial
if found(found3)
revenue.DEMREVID_KFS = found3.DEMREVID_KFS
revenue.SIGNEDDATA = found3.SIGNEDDATA
append new_data row revenue
end
end
// Retain complete native datasets for downstream stages; publication here does not post financial data.
publish new_data as "NEW_DATA"
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group4 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
// Fill initial dimensions with their original NA members; GEO_DRIVERS uses GDRVS_NA.
defaults group4 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group4 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
// Display a bounded sample for review; source totals and complete SAP working datasets remain separate.
show group4 as "CONTROL_TOTALS"
