script version 2
dataset sap_revenues = "step_01" named "SAP_REVENUES"
dataset new_data = "step_01" named "NEW_DATA"
dataset input_data = "step_01" named "INPUT_DATA"
dataset conn_reg_split = "step_01" named "CONN_REG_SPLIT"
dataset l1_l2_mapping = "step_01" named "L1_L2_MAPPING"
dataset mat_group_mapping = "step_01" named "MAT_GROUP_MAPPING"
dataset product_members = "step_01" named "PRODUCT_MEMBERS"
dataset material_members = "step_01" named "MATERIAL_MEMBERS"
dataset group_members = "step_01" named "GROUP_MEMBERS"
filter filtered1 = input_data as f2 where f2.DEMREVID_KFS == "DEMREVID036"
filter filtered3 = input_data as f4 where f4.DEMREVID_KFS == "DEMREVID037"
filter filtered5 = input_data as f6 where f6.DEMREVID_KFS == "DEMREVID014"
sort filtered1 unstable by TIME asc, ACCOUNT asc, MATCONN asc
sort filtered3 unstable by TIME asc, MATCONN asc, MAT_GROUP_ID asc
sort filtered5 unstable by TIME asc, MATCONN asc
for revenue7 in sap_revenues
find found8 = filtered5 where TIME = revenue7.TIME and MATCONN = revenue7.MATCONN search binary missing initial
if found(found8)
let mapped10 = ""
for product9 in product_members
if matches(product9.ID, "PRODUCT_TYPE_+++")
if integer(slice(product9.ID, 13, 3)) == integer(found8.SIGNEDDATA)
mapped10 = text(product9.ID)
break
end
end
end
if mapped10 != ""
revenue7.PRODUCT_TYPE = mapped10
else
revenue7.PRODUCT_TYPE = found8.PRODUCT_TYPE
end
end
find found11 = product_members where ID = revenue7.PRODUCT_TYPE search linear missing initial
revenue7.REV_ID_GROUP = found11.REV_ID_GROUP
find found12 = conn_reg_split where TIME = revenue7.TIME and ACCOUNT = revenue7.ACCOUNT search binary missing initial
if found(found12)
revenue7.CONN_REG_SPLIT = found12.CONN_REG_SPLIT
end
find found13 = l1_l2_mapping where TIME = revenue7.TIME and ACCOUNT = revenue7.ACCOUNT search binary missing initial
if found(found13)
revenue7.FFLAS_SUBSET = found13.FFLAS_SUBSET
end
find found14 = filtered1 where TIME = revenue7.TIME and ACCOUNT = revenue7.ACCOUNT and MATCONN = revenue7.MATCONN search binary missing initial
if found(found14)
revenue7.MATREMAP = found14.MATREMAP
else
find found15 = filtered1 where TIME = revenue7.TIME and ACCOUNT = "ACCOUNT_NA" and MATCONN = revenue7.MATCONN search binary missing initial
if found(found15)
revenue7.MATREMAP = found15.MATREMAP
else
if revenue7.MATCONN == "MATCONN_NA"
revenue7.MATREMAP = "MATREMAP_NA"
else
revenue7.MATREMAP = revenue7.MATCONN
end
end
end
if revenue7.PRODUCT_TYPE == "PRODUCT_TYPE_NA" and revenue7.MATREMAP != "MATREMAP_NA"
find found16 = material_members where ID = revenue7.MATREMAP search linear missing initial
revenue7.PRODUCT_TYPE = found16.PRODUCT_TYPE
end
if revenue7.MATREMAP != "MATREMAP_NA"
find found17 = mat_group_mapping where TIME = revenue7.TIME and MATCONN = revenue7.MATREMAP and ACCOUNT = "ACCOUNT_NA" search binary missing initial
if found(found17)
revenue7.MAT_GROUP_ID = found17.MAT_GROUP_ID
end
else
find found18 = mat_group_mapping where TIME = revenue7.TIME and MATCONN = "MATCONN_NA" and ACCOUNT = revenue7.ACCOUNT search binary missing initial
if found(found18)
revenue7.MAT_GROUP_ID = found18.MAT_GROUP_ID
end
end
find found19 = group_members where ID = revenue7.MAT_GROUP_ID search linear missing initial
if not initial(found19.REV_ID_GROUP)
revenue7.REV_ID_GROUP = found19.REV_ID_GROUP
end
find found20 = filtered3 where TIME = revenue7.TIME and MATCONN = "MATCONN_NA" and MAT_GROUP_ID = revenue7.MAT_GROUP_ID search binary missing initial
if found(found20)
revenue7.REG_FFLAS_SERV = found20.REG_FFLAS_SERV
else
find found21 = filtered3 where TIME = revenue7.TIME and MATCONN = revenue7.MATREMAP search binary missing initial
if found(found21)
revenue7.REG_FFLAS_SERV = found21.REG_FFLAS_SERV
end
end
end
append new_data from sap_revenues
publish sap_revenues as "SAP_REVENUES"
publish new_data as "NEW_DATA"
group group22 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
for g23 in group22
if initial(g23.ACCOUNT)
g23.ACCOUNT = "ACCOUNT_NA"
end
if initial(g23.AUDITTRAIL)
g23.AUDITTRAIL = "AUDITTRAIL_NA"
end
if initial(g23.CATEGORY)
g23.CATEGORY = "CATEGORY_NA"
end
if initial(g23.COSTCENTRE)
g23.COSTCENTRE = "COSTCENTRE_NA"
end
if initial(g23.DEMREVID_KFS)
g23.DEMREVID_KFS = "DEMREVID_KFS_NA"
end
if initial(g23.FFLAS)
g23.FFLAS = "FFLAS_NA"
end
if initial(g23.FFLAS_SUBSET)
g23.FFLAS_SUBSET = "FFLAS_SUBSET_NA"
end
if initial(g23.MATCONN)
g23.MATCONN = "MATCONN_NA"
end
if initial(g23.TIME)
g23.TIME = "TIME_NA"
end
if initial(g23.PRODUCT_TYPE)
g23.PRODUCT_TYPE = "PRODUCT_TYPE_NA"
end
if initial(g23.GEO_DRIVERS)
g23.GEO_DRIVERS = "GDRVS_NA"
end
if initial(g23.DOC_TYP)
g23.DOC_TYP = "DOC_TYP_NA"
end
if initial(g23.CONN_REG_SPLIT)
g23.CONN_REG_SPLIT = "CONN_REG_SPLIT_NA"
end
if initial(g23.LFC_WIN_SUPPLIER)
g23.LFC_WIN_SUPPLIER = "LFC_WIN_SUPPLIER_NA"
end
if initial(g23.MAT_GROUP_ID)
g23.MAT_GROUP_ID = "MAT_GROUP_ID_NA"
end
if initial(g23.REG_FFLAS_SERV)
g23.REG_FFLAS_SERV = "REG_FFLAS_SERV_NA"
end
if initial(g23.UFB_DR_ID)
g23.UFB_DR_ID = "UFB_DR_ID_NA"
end
if initial(g23.MATREMAP)
g23.MATREMAP = "MATREMAP_NA"
end
if initial(g23.RSP_SERVICE_ID)
g23.RSP_SERVICE_ID = "RSP_SERVICE_ID_NA"
end
if initial(g23.REV_ID_GROUP)
g23.REV_ID_GROUP = "REV_ID_GROUP_NA"
end
end
sort group22 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
show group22 as "CONTROL_TOTALS"
