script version 2 compact
// DEMREVID003 business-rule notes
// Combine billed and unbilled revenue
// Combine the SAP revenue key figures at the original reporting grain by grouping out the key figure. Other
// dimensions remain as in the original calculation.
// Check: Compare the complete signed total before and after grouping; do not reverse revenue signs.
// Complete working tables stay in SAP; displayed previews are not calculation inputs.

// Read the complete SAP_REVENUES working table retained by step_02.
dataset sap_revenues = "step_02" named "SAP_REVENUES"
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group1 = sap_revenues exclude ["DEMREVID_KFS"]
// Fill initial dimensions with their original NA members; GEO_DRIVERS uses GDRVS_NA.
defaults group1 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
// Preserve the original sort keys and tie behavior used by subsequent lookups.
sort group1 unstable by DEMREVID_KFS asc
copy sap_revenues_consol = group1
// Retain complete native datasets for downstream stages; publication here does not post financial data.
publish sap_revenues_consol as "SAP_REVENUES_CONSOL"
