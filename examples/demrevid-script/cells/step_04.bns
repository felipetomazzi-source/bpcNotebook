script version 2 compact
dataset sap_revenues_consol = "step_03" named "SAP_REVENUES_CONSOL"
dataset new_data = "step_02" named "NEW_DATA"
dataset rsp_location_material_ratio = "step_01" named "RSP_LOCATION_MATERIAL_RATIO"
dataset rsp_location_gl_ratio = "step_01" named "RSP_LOCATION_GL_RATIO"
dataset cal_location_gl_ratio = "step_01" named "CAL_LOCATION_GL_RATIO"
dataset cal_location_conn_seg_ratio = "step_01" named "CAL_LOCATION_CONN_SEG_RATIO"
for base1 in sap_revenues_consol copy
base1.DEMREVID_KFS = "DEMREVID009"
let method2 = 5
if method2 == 5
find found3 = rsp_location_material_ratio where TIME = base1.TIME and MATCONN = base1.MATCONN search binary missing initial
if found(found3)
method2 = 1
end
end
if method2 == 5
find found4 = rsp_location_gl_ratio where TIME = base1.TIME and ACCOUNT = base1.ACCOUNT search binary missing initial
if found(found4)
method2 = 2
end
end
if method2 == 5
find found5 = cal_location_gl_ratio where TIME = base1.TIME and ACCOUNT = base1.ACCOUNT search binary missing initial
if found(found5)
method2 = 3
end
end
if method2 == 5
find found6 = cal_location_conn_seg_ratio where TIME = base1.TIME and CONN_REG_SPLIT = base1.CONN_REG_SPLIT search binary missing initial
if found(found6)
method2 = 4
end
end
base1.SIGNEDDATA = integer(method2)
append new_data row base1
end
publish new_data as "NEW_DATA"
group group7 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
defaults group7 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group7 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
show group7 as "CONTROL_TOTALS"
