script version 2 compact
// DEMREVID003 business-rule notes
// Allocate ID-only revenue by supplier
// Replace each matching ID-only allocated revenue row with supplier splits. When no supplier driver exists,
// keep the original row as the original calculation does.
// Check: Reconcile the replaced row to its splits and verify no-driver rows are retained.
// Complete working tables stay in SAP; displayed previews are not calculation inputs.

// Read the complete NEW_DATA working table retained by step_13.
dataset new_data = "step_13" named "NEW_DATA"
// Read the complete SUPPLIER_RATIOS working table retained by step_13.
dataset supplier_ratios = "step_13" named "SUPPLIER_RATIOS"
empty supplier_allocated = new_data
// Index the complete working table; matching rows and first-match lookup precedence remain explicit.
index ix2 = supplier_ratios by ["TIME","ACCOUNT","MATCONN"] many
for original in new_data
if original.DEMREVID_KFS == "DEMREVID023" and original.FFLAS == "FFLASID"
// A missing lookup returns initial values; the following found checks and fallback branches control the outcome.
find found1 = supplier_ratios where TIME = original.TIME and ACCOUNT = original.ACCOUNT and MATCONN = original.MATCONN search binary missing initial
if found(found1)
match matches3 = ix2 where TIME = original.TIME and ACCOUNT = original.ACCOUNT and MATCONN = original.MATCONN
for supplier_row in matches3
copy row4 = original
row4.SIGNEDDATA = original.SIGNEDDATA * supplier_row.SIGNEDDATA
row4.LFC_WIN_SUPPLIER = supplier_row.LFC_WIN_SUPPLIER
append supplier_allocated row row4
end
delete original
end
end
end
append new_data from supplier_allocated
// Retain complete native datasets for downstream stages; publication here does not post financial data.
publish new_data as "NEW_DATA"
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group5 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
// Fill initial dimensions with their original NA members; GEO_DRIVERS uses GDRVS_NA.
defaults group5 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
// Preserve the original sort keys and tie behavior used by subsequent lookups.
sort group5 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
// Display a bounded sample for review; source totals and complete SAP working datasets remain separate.
show group5 as "CONTROL_TOTALS"
