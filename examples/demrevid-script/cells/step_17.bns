script version 2
dataset sap_revenues = "step_02" named "SAP_REVENUES"
dataset new_data = "step_16" named "NEW_DATA"
empty fflas_ratios = new_data
empty skipped_materials = new_data
group group1 = sap_revenues include ["CATEGORY","TIME","ACCOUNT","MATCONN","MAT_GROUP_ID"]
for g2 in group1
if initial(g2.ACCOUNT)
g2.ACCOUNT = "ACCOUNT_NA"
end
if initial(g2.AUDITTRAIL)
g2.AUDITTRAIL = "AUDITTRAIL_NA"
end
if initial(g2.CATEGORY)
g2.CATEGORY = "CATEGORY_NA"
end
if initial(g2.COSTCENTRE)
g2.COSTCENTRE = "COSTCENTRE_NA"
end
if initial(g2.DEMREVID_KFS)
g2.DEMREVID_KFS = "DEMREVID_KFS_NA"
end
if initial(g2.FFLAS)
g2.FFLAS = "FFLAS_NA"
end
if initial(g2.FFLAS_SUBSET)
g2.FFLAS_SUBSET = "FFLAS_SUBSET_NA"
end
if initial(g2.MATCONN)
g2.MATCONN = "MATCONN_NA"
end
if initial(g2.TIME)
g2.TIME = "TIME_NA"
end
if initial(g2.PRODUCT_TYPE)
g2.PRODUCT_TYPE = "PRODUCT_TYPE_NA"
end
if initial(g2.GEO_DRIVERS)
g2.GEO_DRIVERS = "GDRVS_NA"
end
if initial(g2.DOC_TYP)
g2.DOC_TYP = "DOC_TYP_NA"
end
if initial(g2.CONN_REG_SPLIT)
g2.CONN_REG_SPLIT = "CONN_REG_SPLIT_NA"
end
if initial(g2.LFC_WIN_SUPPLIER)
g2.LFC_WIN_SUPPLIER = "LFC_WIN_SUPPLIER_NA"
end
if initial(g2.MAT_GROUP_ID)
g2.MAT_GROUP_ID = "MAT_GROUP_ID_NA"
end
if initial(g2.REG_FFLAS_SERV)
g2.REG_FFLAS_SERV = "REG_FFLAS_SERV_NA"
end
if initial(g2.UFB_DR_ID)
g2.UFB_DR_ID = "UFB_DR_ID_NA"
end
if initial(g2.MATREMAP)
g2.MATREMAP = "MATREMAP_NA"
end
if initial(g2.RSP_SERVICE_ID)
g2.RSP_SERVICE_ID = "RSP_SERVICE_ID_NA"
end
if initial(g2.REV_ID_GROUP)
g2.REV_ID_GROUP = "REV_ID_GROUP_NA"
end
end
sort group1 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, MAT_GROUP_ID asc
for replace3 in group1
replace3.AUDITTRAIL = "DEMREVID_CALC"
replace3.DEMREVID_KFS = "DEMREVID047"
end
show group1 as "RATIO_BASE_BEFORE_EXCLUSIONS"
let skip_ids = split(input("FFLASMATGROUPSID"), ",")
let skip_flag_text = input("FFLASMATGROUPS")
if skip_flag_text == "true"
skip_flag_text = "1"
end
if skip_flag_text == "false"
skip_flag_text = "0"
end
let skip_flags = split(skip_flag_text, ",")
table skip_members columns ID member
row skip_member like skip_members
let skip_position = 0
for skip_id in skip_ids
skip_position = skip_position + 1
if skip_position <= count(skip_flags)
if number(at(skip_flags,skip_position)) != 0
skip_member.ID = skip_id
append skip_members row skip_member
end
end
end
for base_row in group1
find found4 = skip_members where ID = base_row.MAT_GROUP_ID search linear missing initial
if found(found4)
copy row5 = base_row
row5.MAT_GROUP_ID = ""
row5.DEMREVID_KFS = "DEMREVID052"
row5.FFLAS = "FFLAS_NA"
row5.SIGNEDDATA = 1
find found6 = skipped_materials where TIME = row5.TIME and ACCOUNT = row5.ACCOUNT and MATCONN = row5.MATCONN search linear missing initial
if not found(found6)
append skipped_materials row row5
end
delete base_row
end
end
show skipped_materials as "SKIPPED_MATERIAL_FLAGS"
show group1 as "RATIO_BASE_AFTER_EXCLUSIONS"
group group7 = group1 exclude ["MAT_GROUP_ID"]
for g8 in group7
if initial(g8.ACCOUNT)
g8.ACCOUNT = "ACCOUNT_NA"
end
if initial(g8.AUDITTRAIL)
g8.AUDITTRAIL = "AUDITTRAIL_NA"
end
if initial(g8.CATEGORY)
g8.CATEGORY = "CATEGORY_NA"
end
if initial(g8.COSTCENTRE)
g8.COSTCENTRE = "COSTCENTRE_NA"
end
if initial(g8.DEMREVID_KFS)
g8.DEMREVID_KFS = "DEMREVID_KFS_NA"
end
if initial(g8.FFLAS)
g8.FFLAS = "FFLAS_NA"
end
if initial(g8.FFLAS_SUBSET)
g8.FFLAS_SUBSET = "FFLAS_SUBSET_NA"
end
if initial(g8.MATCONN)
g8.MATCONN = "MATCONN_NA"
end
if initial(g8.TIME)
g8.TIME = "TIME_NA"
end
if initial(g8.PRODUCT_TYPE)
g8.PRODUCT_TYPE = "PRODUCT_TYPE_NA"
end
if initial(g8.GEO_DRIVERS)
g8.GEO_DRIVERS = "GDRVS_NA"
end
if initial(g8.DOC_TYP)
g8.DOC_TYP = "DOC_TYP_NA"
end
if initial(g8.CONN_REG_SPLIT)
g8.CONN_REG_SPLIT = "CONN_REG_SPLIT_NA"
end
if initial(g8.LFC_WIN_SUPPLIER)
g8.LFC_WIN_SUPPLIER = "LFC_WIN_SUPPLIER_NA"
end
if initial(g8.MAT_GROUP_ID)
g8.MAT_GROUP_ID = "MAT_GROUP_ID_NA"
end
if initial(g8.REG_FFLAS_SERV)
g8.REG_FFLAS_SERV = "REG_FFLAS_SERV_NA"
end
if initial(g8.UFB_DR_ID)
g8.UFB_DR_ID = "UFB_DR_ID_NA"
end
if initial(g8.MATREMAP)
g8.MATREMAP = "MATREMAP_NA"
end
if initial(g8.RSP_SERVICE_ID)
g8.RSP_SERVICE_ID = "RSP_SERVICE_ID_NA"
end
if initial(g8.REV_ID_GROUP)
g8.REV_ID_GROUP = "REV_ID_GROUP_NA"
end
end
sort group7 unstable by MAT_GROUP_ID asc
filter filtered9 = new_data as f10 where f10.DEMREVID_KFS == "DEMREVID023"
group group11 = filtered9 include ["CATEGORY","TIME","ACCOUNT","MATCONN","FFLAS","MAT_GROUP_ID"]
for g12 in group11
if initial(g12.ACCOUNT)
g12.ACCOUNT = "ACCOUNT_NA"
end
if initial(g12.AUDITTRAIL)
g12.AUDITTRAIL = "AUDITTRAIL_NA"
end
if initial(g12.CATEGORY)
g12.CATEGORY = "CATEGORY_NA"
end
if initial(g12.COSTCENTRE)
g12.COSTCENTRE = "COSTCENTRE_NA"
end
if initial(g12.DEMREVID_KFS)
g12.DEMREVID_KFS = "DEMREVID_KFS_NA"
end
if initial(g12.FFLAS)
g12.FFLAS = "FFLAS_NA"
end
if initial(g12.FFLAS_SUBSET)
g12.FFLAS_SUBSET = "FFLAS_SUBSET_NA"
end
if initial(g12.MATCONN)
g12.MATCONN = "MATCONN_NA"
end
if initial(g12.TIME)
g12.TIME = "TIME_NA"
end
if initial(g12.PRODUCT_TYPE)
g12.PRODUCT_TYPE = "PRODUCT_TYPE_NA"
end
if initial(g12.GEO_DRIVERS)
g12.GEO_DRIVERS = "GDRVS_NA"
end
if initial(g12.DOC_TYP)
g12.DOC_TYP = "DOC_TYP_NA"
end
if initial(g12.CONN_REG_SPLIT)
g12.CONN_REG_SPLIT = "CONN_REG_SPLIT_NA"
end
if initial(g12.LFC_WIN_SUPPLIER)
g12.LFC_WIN_SUPPLIER = "LFC_WIN_SUPPLIER_NA"
end
if initial(g12.MAT_GROUP_ID)
g12.MAT_GROUP_ID = "MAT_GROUP_ID_NA"
end
if initial(g12.REG_FFLAS_SERV)
g12.REG_FFLAS_SERV = "REG_FFLAS_SERV_NA"
end
if initial(g12.UFB_DR_ID)
g12.UFB_DR_ID = "UFB_DR_ID_NA"
end
if initial(g12.MATREMAP)
g12.MATREMAP = "MATREMAP_NA"
end
if initial(g12.RSP_SERVICE_ID)
g12.RSP_SERVICE_ID = "RSP_SERVICE_ID_NA"
end
if initial(g12.REV_ID_GROUP)
g12.REV_ID_GROUP = "REV_ID_GROUP_NA"
end
end
sort group11 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, FFLAS asc, MAT_GROUP_ID asc
for replace13 in group11
replace13.AUDITTRAIL = "DEMREVID_CALC"
replace13.DEMREVID_KFS = "DEMREVID047"
end
index ix14 = group11 by ["TIME","ACCOUNT","MATCONN"] many
show group11 as "FFLAS_REVENUE_NUMERATORS"
for denominator in group7 copy
if not initial(denominator.SIGNEDDATA)
native remainder = denominator.SIGNEDDATA
match matches15 = ix14 where TIME = denominator.TIME and ACCOUNT = denominator.ACCOUNT and MATCONN = denominator.MATCONN
for numerator in matches15 copy
remainder = remainder - numerator.SIGNEDDATA
numerator.SIGNEDDATA = numerator.SIGNEDDATA / denominator.SIGNEDDATA
append fflas_ratios row numerator
end
if not initial(remainder)
denominator.SIGNEDDATA = remainder / denominator.SIGNEDDATA
denominator.FFLAS = "FFLASNON"
find found16 = fflas_ratios where ACCOUNT = denominator.ACCOUNT and AUDITTRAIL = denominator.AUDITTRAIL and CATEGORY = denominator.CATEGORY and COSTCENTRE = denominator.COSTCENTRE and DEMREVID_KFS = denominator.DEMREVID_KFS and FFLAS = denominator.FFLAS and FFLAS_SUBSET = denominator.FFLAS_SUBSET and MATCONN = denominator.MATCONN and TIME = denominator.TIME and PRODUCT_TYPE = denominator.PRODUCT_TYPE and GEO_DRIVERS = denominator.GEO_DRIVERS and DOC_TYP = denominator.DOC_TYP and CONN_REG_SPLIT = denominator.CONN_REG_SPLIT and LFC_WIN_SUPPLIER = denominator.LFC_WIN_SUPPLIER and MAT_GROUP_ID = denominator.MAT_GROUP_ID and REG_FFLAS_SERV = denominator.REG_FFLAS_SERV and UFB_DR_ID = denominator.UFB_DR_ID and MATREMAP = denominator.MATREMAP and RSP_SERVICE_ID = denominator.RSP_SERVICE_ID and REV_ID_GROUP = denominator.REV_ID_GROUP search linear missing initial
if found(found16)
found16.SIGNEDDATA = found16.SIGNEDDATA + denominator.SIGNEDDATA
else
append fflas_ratios row denominator
end
end
end
end
show fflas_ratios as "RATIOS_BEFORE_ROUNDING"
group group17 = fflas_ratios exclude ["FFLAS","MAT_GROUP_ID"]
for g18 in group17
if initial(g18.ACCOUNT)
g18.ACCOUNT = "ACCOUNT_NA"
end
if initial(g18.AUDITTRAIL)
g18.AUDITTRAIL = "AUDITTRAIL_NA"
end
if initial(g18.CATEGORY)
g18.CATEGORY = "CATEGORY_NA"
end
if initial(g18.COSTCENTRE)
g18.COSTCENTRE = "COSTCENTRE_NA"
end
if initial(g18.DEMREVID_KFS)
g18.DEMREVID_KFS = "DEMREVID_KFS_NA"
end
if initial(g18.FFLAS)
g18.FFLAS = "FFLAS_NA"
end
if initial(g18.FFLAS_SUBSET)
g18.FFLAS_SUBSET = "FFLAS_SUBSET_NA"
end
if initial(g18.MATCONN)
g18.MATCONN = "MATCONN_NA"
end
if initial(g18.TIME)
g18.TIME = "TIME_NA"
end
if initial(g18.PRODUCT_TYPE)
g18.PRODUCT_TYPE = "PRODUCT_TYPE_NA"
end
if initial(g18.GEO_DRIVERS)
g18.GEO_DRIVERS = "GDRVS_NA"
end
if initial(g18.DOC_TYP)
g18.DOC_TYP = "DOC_TYP_NA"
end
if initial(g18.CONN_REG_SPLIT)
g18.CONN_REG_SPLIT = "CONN_REG_SPLIT_NA"
end
if initial(g18.LFC_WIN_SUPPLIER)
g18.LFC_WIN_SUPPLIER = "LFC_WIN_SUPPLIER_NA"
end
if initial(g18.MAT_GROUP_ID)
g18.MAT_GROUP_ID = "MAT_GROUP_ID_NA"
end
if initial(g18.REG_FFLAS_SERV)
g18.REG_FFLAS_SERV = "REG_FFLAS_SERV_NA"
end
if initial(g18.UFB_DR_ID)
g18.UFB_DR_ID = "UFB_DR_ID_NA"
end
if initial(g18.MATREMAP)
g18.MATREMAP = "MATREMAP_NA"
end
if initial(g18.RSP_SERVICE_ID)
g18.RSP_SERVICE_ID = "RSP_SERVICE_ID_NA"
end
if initial(g18.REV_ID_GROUP)
g18.REV_ID_GROUP = "REV_ID_GROUP_NA"
end
end
sort group17 unstable by FFLAS asc, MAT_GROUP_ID asc
filter filtered19 = group17 as f20 where f20.SIGNEDDATA != 1
sort fflas_ratios unstable by TIME asc, ACCOUNT asc, MATCONN asc
for ratio_sum in filtered19
find found21 = fflas_ratios where TIME = ratio_sum.TIME and ACCOUNT = ratio_sum.ACCOUNT and MATCONN = ratio_sum.MATCONN search binary missing initial
if found(found21)
let balance = signed(1 - ratio_sum.SIGNEDDATA)
found21.SIGNEDDATA = found21.SIGNEDDATA + balance
end
end
append fflas_ratios from skipped_materials
show fflas_ratios as "RATIOS_AND_FLAGS"
append new_data from fflas_ratios
publish new_data as "NEW_DATA"
group group22 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
for g23 in group22
if initial(g23.ACCOUNT)
g23.ACCOUNT = "ACCOUNT_NA"
end
if initial(g23.AUDITTRAIL)
g23.AUDITTRAIL = "AUDITTRAIL_NA"
end
if initial(g23.CATEGORY)
g23.CATEGORY = "CATEGORY_NA"
end
if initial(g23.COSTCENTRE)
g23.COSTCENTRE = "COSTCENTRE_NA"
end
