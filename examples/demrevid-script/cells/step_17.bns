script version 2 compact
// DEMREVID003 business-rule notes
// Calculate material FFLAS ratios and skipped flags
// Build SAP revenue denominators; create DEMREVID052 flags for suppressed material groups before excluding
// them. Divide allocated FFLAS revenue by the remaining base, assign residual to non-FFLAS, and add
// rounding discrepancy to the same existing row selected by the original ordering.
// Check: Ratios reconcile to one for nonzero eligible bases. Suppressed combinations have flags rather than
// ratios. Test rounding, negative bases, zero bases and both suppression settings.
// Complete working tables stay in SAP; displayed previews are not calculation inputs.

// Read the complete SAP_REVENUES working table retained by step_02.
dataset sap_revenues = "step_02" named "SAP_REVENUES"
// Read the complete NEW_DATA working table retained by step_16.
dataset new_data = "step_16" named "NEW_DATA"
empty fflas_ratios = new_data
empty skipped_materials = new_data
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group1 = sap_revenues include ["CATEGORY","TIME","ACCOUNT","MATCONN","MAT_GROUP_ID"]
// Fill initial dimensions with their original NA members; GEO_DRIVERS uses GDRVS_NA.
defaults group1 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
// Preserve the original sort keys and tie behavior used by subsequent lookups.
sort group1 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, MAT_GROUP_ID asc
for replace2 in group1
replace2.AUDITTRAIL = "DEMREVID_CALC"
replace2.DEMREVID_KFS = "DEMREVID047"
end
// Display a bounded sample for review; source totals and complete SAP working datasets remain separate.
show group1 as "RATIO_BASE_BEFORE_EXCLUSIONS"
let raw3 = input("FFLASMATGROUPSID")
let parts4 = split(raw3,",")
table range5 columns ID member
row range_row6 like range5
for value7 in parts4
range_row6.ID = no_gaps(value7)
append range5 row range_row6
end
sort range5 unstable by ID asc
deduplicate range5 adjacent by ["ID"]
let raw8 = input("FFLASMATGROUPS")
if raw8 == "true"
raw8 = "1"
end
if raw8 == "false"
raw8 = "0"
end
let parts9 = split(raw8,",")
table range10 columns ID member
row range_row11 like range10
for value12 in parts9
range_row11.ID = no_gaps(value12)
append range10 row range_row11
end
sort range10 unstable by ID asc
deduplicate range10 adjacent by ["ID"]
table positioned_flags columns POSITION integer, FLAG member
row positioned_flag like positioned_flags
let flag_position = 0
for flag_value in range10
flag_position = flag_position + 1
positioned_flag.POSITION = integer(flag_position)
positioned_flag.FLAG = flag_value.ID
append positioned_flags row positioned_flag
end
table skip_members columns ID member
row skip_member like skip_members
let skip_position = 0
for skip_id in range5
skip_position = skip_position + 1
// A missing lookup returns initial values; the following found checks and fallback branches control the outcome.
find found13 = positioned_flags where POSITION = integer(skip_position) search linear missing initial
if found(found13)
if not initial(found13.FLAG)
if signed(found13.FLAG) != 0
skip_member.ID = skip_id.ID
append skip_members row skip_member
end
end
end
end
for base_row in group1
find found14 = skip_members where ID = base_row.MAT_GROUP_ID search linear missing initial
if found(found14)
copy row15 = base_row
row15.MAT_GROUP_ID = ""
row15.DEMREVID_KFS = "DEMREVID052"
row15.FFLAS = "FFLAS_NA"
row15.SIGNEDDATA = 1
find found16 = skipped_materials where TIME = row15.TIME and ACCOUNT = row15.ACCOUNT and MATCONN = row15.MATCONN search linear missing initial
if not found(found16)
append skipped_materials row row15
end
delete base_row
end
end
show skipped_materials as "SKIPPED_MATERIAL_FLAGS"
show group1 as "RATIO_BASE_AFTER_EXCLUSIONS"
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group17 = group1 exclude ["MAT_GROUP_ID"]
defaults group17 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group17 unstable by MAT_GROUP_ID asc
// Select the records required by this business block; retain their original signs and dimensions.
filter filtered18 = new_data as f19 where f19.DEMREVID_KFS == "DEMREVID023"
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group20 = filtered18 include ["CATEGORY","TIME","ACCOUNT","MATCONN","FFLAS","MAT_GROUP_ID"]
defaults group20 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group20 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, FFLAS asc, MAT_GROUP_ID asc
for replace21 in group20
replace21.AUDITTRAIL = "DEMREVID_CALC"
replace21.DEMREVID_KFS = "DEMREVID047"
end
// Index the complete working table; matching rows and first-match lookup precedence remain explicit.
index ix22 = group20 by ["TIME","ACCOUNT","MATCONN"] many
show group20 as "FFLAS_REVENUE_NUMERATORS"
for denominator in group17 copy
if not initial(denominator.SIGNEDDATA)
native remainder = denominator.SIGNEDDATA
match matches23 = ix22 where TIME = denominator.TIME and ACCOUNT = denominator.ACCOUNT and MATCONN = denominator.MATCONN
for numerator in matches23 copy
remainder = remainder - numerator.SIGNEDDATA
numerator.SIGNEDDATA = numerator.SIGNEDDATA / denominator.SIGNEDDATA
append fflas_ratios row numerator
end
if not initial(remainder)
denominator.SIGNEDDATA = remainder / denominator.SIGNEDDATA
denominator.FFLAS = "FFLASNON"
find found24 = fflas_ratios where ACCOUNT = denominator.ACCOUNT and AUDITTRAIL = denominator.AUDITTRAIL and CATEGORY = denominator.CATEGORY and COSTCENTRE = denominator.COSTCENTRE and DEMREVID_KFS = denominator.DEMREVID_KFS and FFLAS = denominator.FFLAS and FFLAS_SUBSET = denominator.FFLAS_SUBSET and MATCONN = denominator.MATCONN and TIME = denominator.TIME and PRODUCT_TYPE = denominator.PRODUCT_TYPE and GEO_DRIVERS = denominator.GEO_DRIVERS and DOC_TYP = denominator.DOC_TYP and CONN_REG_SPLIT = denominator.CONN_REG_SPLIT and LFC_WIN_SUPPLIER = denominator.LFC_WIN_SUPPLIER and MAT_GROUP_ID = denominator.MAT_GROUP_ID and REG_FFLAS_SERV = denominator.REG_FFLAS_SERV and UFB_DR_ID = denominator.UFB_DR_ID and MATREMAP = denominator.MATREMAP and RSP_SERVICE_ID = denominator.RSP_SERVICE_ID and REV_ID_GROUP = denominator.REV_ID_GROUP search linear missing initial
if found(found24)
found24.SIGNEDDATA = found24.SIGNEDDATA + denominator.SIGNEDDATA
else
append fflas_ratios row denominator
end
end
end
end
show fflas_ratios as "RATIOS_BEFORE_ROUNDING"
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group25 = fflas_ratios exclude ["FFLAS","MAT_GROUP_ID"]
defaults group25 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group25 unstable by FFLAS asc, MAT_GROUP_ID asc
// Select the records required by this business block; retain their original signs and dimensions.
filter filtered26 = group25 as f27 where f27.SIGNEDDATA != 1
sort fflas_ratios unstable by TIME asc, ACCOUNT asc, MATCONN asc
for ratio_sum in filtered26
find found28 = fflas_ratios where TIME = ratio_sum.TIME and ACCOUNT = ratio_sum.ACCOUNT and MATCONN = ratio_sum.MATCONN search binary missing initial
if found(found28)
let balance = signed(1 - ratio_sum.SIGNEDDATA)
found28.SIGNEDDATA = found28.SIGNEDDATA + balance
end
end
append fflas_ratios from skipped_materials
show fflas_ratios as "RATIOS_AND_FLAGS"
append new_data from fflas_ratios
// Retain complete native datasets for downstream stages; publication here does not post financial data.
publish new_data as "NEW_DATA"
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group29 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
defaults group29 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group29 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
show group29 as "CONTROL_TOTALS"
