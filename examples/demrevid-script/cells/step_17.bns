g23.DEMREVID_KFS = "DEMREVID_KFS_NA"
end
if initial(g23.FFLAS)
g23.FFLAS = "FFLAS_NA"
end
if initial(g23.FFLAS_SUBSET)
g23.FFLAS_SUBSET = "FFLAS_SUBSET_NA"
end
if initial(g23.MATCONN)
g23.MATCONN = "MATCONN_NA"
end
if initial(g23.TIME)
g23.TIME = "TIME_NA"
end
if initial(g23.PRODUCT_TYPE)
g23.PRODUCT_TYPE = "PRODUCT_TYPE_NA"
end
if initial(g23.GEO_DRIVERS)
g23.GEO_DRIVERS = "GDRVS_NA"
end
if initial(g23.DOC_TYP)
g23.DOC_TYP = "DOC_TYP_NA"
end
if initial(g23.CONN_REG_SPLIT)
g23.CONN_REG_SPLIT = "CONN_REG_SPLIT_NA"
end
if initial(g23.LFC_WIN_SUPPLIER)
g23.LFC_WIN_SUPPLIER = "LFC_WIN_SUPPLIER_NA"
end
if initial(g23.MAT_GROUP_ID)
g23.MAT_GROUP_ID = "MAT_GROUP_ID_NA"
end
if initial(g23.REG_FFLAS_SERV)
g23.REG_FFLAS_SERV = "REG_FFLAS_SERV_NA"
end
if initial(g23.UFB_DR_ID)
g23.UFB_DR_ID = "UFB_DR_ID_NA"
end
if initial(g23.MATREMAP)
g23.MATREMAP = "MATREMAP_NA"
end
if initial(g23.RSP_SERVICE_ID)
g23.RSP_SERVICE_ID = "RSP_SERVICE_ID_NA"
end
if initial(g23.REV_ID_GROUP)
g23.REV_ID_GROUP = "REV_ID_GROUP_NA"
end
end
sort group22 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
show group22 as "CONTROL_TOTALS"
