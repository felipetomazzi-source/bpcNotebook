script version 2 compact
// DEMREVID003 business-rule notes
// Allocate the remaining billed revenue
// Subtract already split RSP billing from total SAP billed revenue. Apply geography drivers to the
// remaining signed balance using the original matching dimensions.
// Check: Already split billing plus allocated remainder must reconcile to the original billed base at the
// original grain.
// Complete working tables stay in SAP; displayed previews are not calculation inputs.

// Read the complete NEW_DATA working table retained by step_06.
dataset new_data = "step_06" named "NEW_DATA"
// Read the complete SAP_REVENUES working table retained by step_02.
dataset sap_revenues = "step_02" named "SAP_REVENUES"
// Read the complete RSP_SPLIT_RATIOS working table retained by step_05.
dataset rsp_split_ratios = "step_05" named "RSP_SPLIT_RATIOS"
// Select the records required by this business block; retain their original signs and dimensions.
filter filtered1 = new_data as f2 where f2.DEMREVID_KFS == "DEMREVID016"
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group3 = filtered1 exclude ["GEO_DRIVERS"]
// Fill initial dimensions with their original NA members; GEO_DRIVERS uses GDRVS_NA.
defaults group3 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
// Preserve the original sort keys and tie behavior used by subsequent lookups.
sort group3 unstable by GEO_DRIVERS asc
sort group3 unstable by TIME asc, ACCOUNT asc, MATCONN asc
// Select the records required by this business block; retain their original signs and dimensions.
filter filtered4 = sap_revenues as f5 where f5.DEMREVID_KFS == "DEMREVID006"
// Index the complete working table; matching rows and first-match lookup precedence remain explicit.
index ix8 = rsp_split_ratios by ["MATCONN","ACCOUNT","TIME"] many
for revenue6 in filtered4 copy
// A missing lookup returns initial values; the following found checks and fallback branches control the outcome.
find found7 = group3 where TIME = revenue6.TIME and ACCOUNT = revenue6.ACCOUNT and MATCONN = revenue6.MATCONN search binary missing initial
if found(found7)
revenue6.SIGNEDDATA = revenue6.SIGNEDDATA - found7.SIGNEDDATA
end
if not initial(revenue6.SIGNEDDATA)
match matches9 = ix8 where MATCONN = revenue6.MATCONN and ACCOUNT = revenue6.ACCOUNT and TIME = revenue6.TIME
for ratio10 in matches9
copy row11 = revenue6
row11.DEMREVID_KFS = "DEMREVID017"
row11.GEO_DRIVERS = ratio10.GEO_DRIVERS
row11.SIGNEDDATA = row11.SIGNEDDATA * ratio10.SIGNEDDATA
append new_data row row11
end
end
end
// Retain complete native datasets for downstream stages; publication here does not post financial data.
publish new_data as "NEW_DATA"
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group12 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
defaults group12 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group12 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
// Display a bounded sample for review; source totals and complete SAP working datasets remain separate.
show group12 as "CONTROL_TOTALS"
