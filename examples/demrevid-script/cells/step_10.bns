script version 2 compact
// DEMREVID003 business-rule notes
// Split revenue into PQ, ID-only and non-FFLAS
// Use geography to identify PQ versus ID-only revenue, multiply by the monthly FFLAS percentage, and
// calculate non-FFLAS as the residual of revenue by geography less allocated FFLAS revenue.
// Check: Reconcile allocated FFLAS plus non-FFLAS to the geography revenue. Inspect partial percentages and
// signed residuals.
// Complete working tables stay in SAP; displayed previews are not calculation inputs.

// Read the complete NEW_DATA working table retained by step_09.
dataset new_data = "step_09" named "NEW_DATA"
// Select the records required by this business block; retain their original signs and dimensions.
filter filtered1 = new_data as f2 where f2.DEMREVID_KFS >= "DEMREVID016" and f2.DEMREVID_KFS <= "DEMREVID018"
for replace3 in filtered1
replace3.DEMREVID_KFS = "DEMREVID023"
end
for replace4 in filtered1
if replace4.GEO_DRIVERS >= "GDRVS_002" and replace4.GEO_DRIVERS <= "GDRVS_003"
replace4.FFLAS = "FFLASPQ"
end
end
for replace5 in filtered1
if replace5.GEO_DRIVERS == "GDRVS_001"
replace5.FFLAS = "FFLASID"
end
end
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group6 = filtered1 all
// Select the records required by this business block; retain their original signs and dimensions.
filter filtered7 = new_data as f8 where f8.DEMREVID_KFS == "DEMREVID022"
// Preserve the original sort keys and tie behavior used by subsequent lookups.
sort filtered7 unstable by TIME asc, ACCOUNT asc, MATCONN asc
copy allocated = group6
for allocated_row in allocated
// A missing lookup returns initial values; the following found checks and fallback branches control the outcome.
find found9 = filtered7 where TIME = allocated_row.TIME and ACCOUNT = allocated_row.ACCOUNT and MATCONN = allocated_row.MATCONN search binary missing initial
allocated_row.SIGNEDDATA = allocated_row.SIGNEDDATA * found9.SIGNEDDATA
end
// Select the records required by this business block; retain their original signs and dimensions.
filter filtered10 = allocated as f11 where not initial(f11.SIGNEDDATA)
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group12 = filtered10 exclude ["FFLAS"]
// Fill initial dimensions with their original NA members; GEO_DRIVERS uses GDRVS_NA.
defaults group12 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group12 unstable by FFLAS asc
sort group12 unstable by TIME asc, ACCOUNT asc, MATCONN asc, GEO_DRIVERS asc
copy residual = group6
sort residual unstable by TIME asc, ACCOUNT asc, MATCONN asc, GEO_DRIVERS asc
for residual_row in residual
find found13 = group12 where TIME = residual_row.TIME and ACCOUNT = residual_row.ACCOUNT and MATCONN = residual_row.MATCONN and GEO_DRIVERS = residual_row.GEO_DRIVERS search binary missing initial
if found(found13)
residual_row.SIGNEDDATA = residual_row.SIGNEDDATA - found13.SIGNEDDATA
end
residual_row.FFLAS = "FFLASNON"
end
// Select the records required by this business block; retain their original signs and dimensions.
filter filtered14 = residual as f15 where not initial(f15.SIGNEDDATA)
append new_data from filtered10
append new_data from filtered14
// Retain complete native datasets for downstream stages; publication here does not post financial data.
publish new_data as "NEW_DATA"
// Sum signed amounts using the stated include/exclude dimension list and the original grouping semantics.
group group16 = new_data include ["CATEGORY","TIME","ACCOUNT","MATCONN","AUDITTRAIL","DEMREVID_KFS"]
defaults group16 with ACCOUNT "ACCOUNT_NA", AUDITTRAIL "AUDITTRAIL_NA", CATEGORY "CATEGORY_NA", COSTCENTRE "COSTCENTRE_NA", DEMREVID_KFS "DEMREVID_KFS_NA", FFLAS "FFLAS_NA", FFLAS_SUBSET "FFLAS_SUBSET_NA", MATCONN "MATCONN_NA", TIME "TIME_NA", PRODUCT_TYPE "PRODUCT_TYPE_NA", GEO_DRIVERS "GDRVS_NA", DOC_TYP "DOC_TYP_NA", CONN_REG_SPLIT "CONN_REG_SPLIT_NA", LFC_WIN_SUPPLIER "LFC_WIN_SUPPLIER_NA", MAT_GROUP_ID "MAT_GROUP_ID_NA", REG_FFLAS_SERV "REG_FFLAS_SERV_NA", UFB_DR_ID "UFB_DR_ID_NA", MATREMAP "MATREMAP_NA", RSP_SERVICE_ID "RSP_SERVICE_ID_NA", REV_ID_GROUP "REV_ID_GROUP_NA"
sort group16 unstable by CATEGORY asc, TIME asc, ACCOUNT asc, MATCONN asc, AUDITTRAIL asc, DEMREVID_KFS asc
// Display a bounded sample for review; source totals and complete SAP working datasets remain separate.
show group16 as "CONTROL_TOTALS"
